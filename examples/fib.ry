func fib_speed_test(data n) {
    data a = 0
    data b = 1
    
    foreach data i in 1 to n {
        data temp = a
        a = b
        b = temp + b
    }
    return a
}

data start = Sys.clock()
data result = fib_speed_test(1000000) 
data end = Sys.clock()

out("Fibonacci (1M iterations) Result: " + result)
out("Time Taken: " + (end - start) + " seconds")
