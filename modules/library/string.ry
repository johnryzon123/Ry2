# string.ry - A Ry Standard Library
# "Ry's for You 2" - Feel free to modify these algorithms!

namespace String {
    
    # Returns a portion of the string starting at 'start' with 'length'
    data _lower_to_upper_map = {
        "a": "A", "b": "B", "c": "C", "d": "D", "e": "E", "f": "F", "g": "G", "h": "H",
        "i": "I", "j": "J", "k": "K", "l": "L", "m": "M", "n": "N", "o": "O", "p": "P",
        "q": "Q", "r": "R", "s": "S", "t": "T", "u": "U", "v": "V", "w": "W", "x": "X",
        "y": "Y", "z": "Z"
    }
    data _upper_to_lower_map = {
        "A": "a", "B": "b", "C": "c", "D": "d", "E": "e", "F": "f", "G": "g", "H": "h",
        "I": "i", "J": "j", "K": "k", "L": "l", "M": "m", "N": "n", "O": "o", "P": "p",
        "Q": "q", "R": "r", "S": "s", "T": "t", "U": "u", "V": "v", "W": "w", "X": "x",
        "Y": "y", "Z": "z"
    }


    func substr(data s, data start, data len) {
        if type(s) != "string" { panic "substr: Expected string" }
        
        data res = ""
        data i = start
        data end = start + len
        
        # Guard against going out of bounds
        if end > s.len { end = s.len }
        
        while i < end {
            res = res + s[i]
            i = i + 1
        }
        return res
    }

    # Converts a string to UPPERCASE
    func upper(data s) {
        data res = ""
        data i = 0
        while i < s.len {
            data c = s[i]
            attempt {
                res = res + _lower_to_upper_map[c]
            } fail err {
                res = res + c
            }
            i = i + 1
        }
        return res
    }

    # Converts a string to lowercase
    func lower(data s) {
        data res = ""
        data i = 0
        while i < s.len {
            data c = s[i]
            attempt {
                res = res + _upper_to_lower_map[c]
            } fail err {
                res = res + c
            }
            i = i + 1
        }
        return res
    }

    # Replaces all occurrences of a substring with another
    func replace(data s, data find, data repl) {
        data res = ""
        data i = 0
        while i < s.len {
            if i + find.len <= s.len and substr(s, i, find.len) == find {
                res = res + repl
                i = i + find.len
            } else {
                res = res + s[i]
                i = i + 1
            }
        }
        return res
    }

    # Splits a string by a delimiter into a list of strings
    func split(data s, data delim) {
        data result = []
        if delim == "" {
            data i = 0
            while i < s.len {
                result = result + [s[i]]
                i = i + 1
            }
            return result
        }

        data current = ""
        data i = 0
        while i < s.len {
            if i + delim.len <= s.len and substr(s, i, delim.len) == delim {
                result = result + [current]
                current = ""
                i = i + delim.len
            } else {
                current = current + s[i]
                i = i + 1
            }
        }
        result = result + [current]
        return result
    }

    # Joins a list of strings with a delimiter
    func join(data list, data delim) {
        if list.len == 0 { return "" }
        
        data res = list[0]
        data i = 1
        while i < list.len {
            res = res + delim + list[i]
            i = i + 1
        }
        return res
    }

    # Removes leading and trailing whitespace (spaces only)
    func trim(data s) {
        data start = 0
        while start < s.len and (s[start] == " " or s[start] == "\n" or s[start] == "\r" or s[start] == "\t") {
            start = start + 1
        }

        data end = s.len
        while end > start and (s[end - 1] == " " or s[end - 1] == "\n" or s[end - 1] == "\r" or s[end - 1] == "\t") {
            end = end - 1
        }

        return substr(s, start, end - start)
    }

    # Checks if a string starts with a given prefix
    func startsWith(data s, data prefix) {
        if prefix.len > s.len { return false }
        return substr(s, 0, prefix.len) == prefix
    }

    # Checks if a string ends with a given suffix
    func endsWith(data s, data suffix) {
        if suffix.len > s.len { return false }
        data start = s.len - suffix.len
        return substr(s, start, suffix.len) == suffix
    }
}